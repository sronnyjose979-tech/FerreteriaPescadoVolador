@baseUrl = http://localhost:8000
@token = Bearer 1|testtoken

### 01 Login correcto 200
POST {{baseUrl}}/api/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@ferreteria.com",
  "password": "secret123"
}

### 02 Login credenciales incorrectas 401
POST {{baseUrl}}/api/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@ferreteria.com",
  "password": "wrong"
}

### 03 Login datos invalidos 422
POST {{baseUrl}}/api/login
Content-Type: application/json
Accept: application/json

{
  "email": "no-es-email",
  "password": ""
}

### 04 Listado productos paginado 200
GET {{baseUrl}}/api/products?page=1&per_page=10&q=Martillo&sort=price&direction=desc
Authorization: {{token}}
Accept: application/json

### 05 Listado productos sin token 401
GET {{baseUrl}}/api/products?page=1&per_page=10
Accept: application/json

### 06 Detalle producto 200
GET {{baseUrl}}/api/products/1
Authorization: {{token}}
Accept: application/json

### 07 Detalle producto no existe 404
GET {{baseUrl}}/api/products/9999
Authorization: {{token}}
Accept: application/json

### 08 Crear producto valido 201 Location
POST {{baseUrl}}/api/products
Authorization: {{token}}
Content-Type: application/json
Accept: application/json

{
  "category_id": 1,
  "brand_id": 1,
  "unit_id": 1,
  "name": "Martillo Profesional 16oz",
  "description": "Martillo de acero forjado",
  "sku": "SKU-MART-016-999",
  "barcode": "7501234567899",
  "price": 12500.00,
  "tax_rate": 13.00,
  "stock_quantity": 45,
  "minimum_stock": 10,
  "maximum_stock": 100,
  "weight": 0.45,
  "image_url": "https://ferreteria-ucr.com/images/martillo-16oz.jpg",
  "is_active": true
}

### 09 Crear producto datos invalidos 422
POST {{baseUrl}}/api/products
Authorization: {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "price": -5,
  "sku": ""
}

### 10 Actualizar producto 200
PUT {{baseUrl}}/api/products/1
Authorization: {{token}}
Content-Type: application/json
Accept: application/json

{
  "price": 13500.00,
  "stock_quantity": 50
}

### 11 Actualizar producto no existe 404
PUT {{baseUrl}}/api/products/9999
Authorization: {{token}}
Content-Type: application/json
Accept: application/json

{
  "price": 999
}

### 12 Eliminar producto sin dependencias 204
DELETE {{baseUrl}}/api/products/10
Authorization: {{token}}
Accept: application/json

### 13 Eliminar producto con dependencias 409
DELETE {{baseUrl}}/api/products/1
Authorization: {{token}}
Accept: application/json

### 14 Reporte inventario agregado 200
GET {{baseUrl}}/api/products/inventory-summary
Authorization: {{token}}
Accept: application/json

### 15 Crear proveedor valido 201
POST {{baseUrl}}/api/suppliers
Authorization: {{token}}
Content-Type: application/json
Accept: application/json

{
  "id_supplier": "SUP999",
  "supplier_first_name": "Juan",
  "supplier_last_name": "Perez",
  "supplier_phone": "88888888",
  "supplier_address": "Calle 1",
  "supplier_email": "juan.perez@example.com",
  "supplier_type": "Herramientas"
}

### 16 Listado anidado items de una compra 200
GET {{baseUrl}}/api/purchases/PUR-100/items?page=1&per_page=10
Authorization: {{token}}
Accept: application/json

### 17 Crear compra con descuento 201
POST {{baseUrl}}/api/purchases
Authorization: {{token}}
Content-Type: application/json
Accept: application/json

{
  "id_purchase": "PUR-100",
  "user_id": 1,
  "id_supplier": "SUP999",
  "purchase_status": "pendiente",
  "purchase_total": 11400,
  "items": [
    {"product_id": 1, "quantity": 2, "unit_cost": 6000, "subtotal": 12000}
  ]
}

### 18 Crear compra sin detalle 422
POST {{baseUrl}}/api/purchases
Authorization: {{token}}
Content-Type: application/json
Accept: application/json

{
  "id_purchase": "PUR-101",
  "user_id": 1,
  "id_supplier": "SUP999",
  "purchase_status": "pendiente",
  "purchase_total": 0,
  "items": []
}
