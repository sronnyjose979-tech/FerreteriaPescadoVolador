@token = Bearer 1|testtoken

### Listado productos con paginacion, orden y filtros
GET http://localhost:8000/api/products?per_page=10&sort=price&direction=desc&q=Martillo&category_id=1&brand_id=2
Accept: application/json
Authorization: {{token}}

### Crear producto valido
POST http://localhost:8000/api/products
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "category_id": 1,
  "brand_id": 1,
  "unit_id": 1,
  "name": "Martillo Profesional 16oz",
  "description": "Martillo de acero forjado",
  "sku": "SKU-MART-016-999",
  "barcode": "7501234567899",
  "price": 12500.00,
  "tax_rate": 13.00,
  "stock_quantity": 45,
  "minimum_stock": 10,
  "maximum_stock": 100,
  "weight": 0.45,
  "image_url": "https://ferreteria-ucr.com/images/martillo-16oz.jpg",
  "is_active": true
}

### Crear producto datos invalidos
POST http://localhost:8000/api/products
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "name": "",
  "price": -5,
  "sku": "SKU-MART-016-001"
}

### Actualizar producto
PUT http://localhost:8000/api/products/1
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "price": 13500.00,
  "stock_quantity": 50
}

### Eliminar producto con dependencias (espera 409)
DELETE http://localhost:8000/api/products/1
Accept: application/json
Authorization: {{token}}

### Listado proveedores paginado
GET http://localhost:8000/api/suppliers?per_page=5&sort=supplier_first_name&direction=asc&q=Juan
Accept: application/json
Authorization: {{token}}

### Crear proveedor
POST http://localhost:8000/api/suppliers
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "id_supplier": "SUP999",
  "supplier_first_name": "Juan",
  "supplier_last_name": "Perez",
  "supplier_phone": "88888888",
  "supplier_address": "Calle 1",
  "supplier_email": "juan.perez@example.com",
  "supplier_type": "Herramientas"
}

### Crear compra con detalle y descuento
POST http://localhost:8000/api/purchases
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "id_purchase": "PUR-100",
  "id_supplier": "SUP999",
  "purchase_status": "pendiente",
  "purchase_total": 11400,
  "items": [
    {"product_id": 1, "quantity": 2, "unit_cost": 6000, "subtotal": 12000}
  ]
}

### Crear compra sin detalle (espera 409)
POST http://localhost:8000/api/purchases
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "id_purchase": "PUR-101",
  "id_supplier": "SUP999",
  "purchase_status": "pendiente",
  "purchase_total": 0,
  "items": []
}

### Crear detalle con subtotal incoherente (espera 409)
POST http://localhost:8000/api/purchase-items
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "id_purchase": "PUR-100",
  "product_id": 1,
  "quantity": 2,
  "unit_cost": 100,
  "subtotal": 999
}
